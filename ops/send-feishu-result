#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

if [[ $# -lt 1 || $# -gt 2 || ( $# -eq 2 && "$2" != "--force" ) ]]; then
  echo "用法：ops/send-feishu-result <结果目录> [--force]" >&2
  exit 64
fi

[[ -x .venv/bin/python ]] || {
  echo "Development environment is not initialized." >&2
  exit 69
}

exec .venv/bin/python -m roguetrader.publisher feishu-send "$@"
