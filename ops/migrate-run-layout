#!/usr/bin/env bash
set -euo pipefail
umask 077

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -x "$PROJECT_ROOT/.venv/bin/python" ]] || {
  echo "Development environment is not initialized." >&2
  exit 69
}
exec "$PROJECT_ROOT/.venv/bin/python" "$PROJECT_ROOT/ops/migrate_run_layout.py" "$@"
