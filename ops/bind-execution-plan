#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -x "$PROJECT_ROOT/.venv/bin/python" ]] || {
  echo "Development environment is missing: $PROJECT_ROOT/.venv" >&2
  exit 69
}

cd "$PROJECT_ROOT"
export PYTHONDONTWRITEBYTECODE=1
exec .venv/bin/python -m roguetrader.execution "$@"
