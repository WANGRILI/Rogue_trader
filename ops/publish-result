#!/usr/bin/env bash
set -euo pipefail
umask 077

PUBLISH_PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -x "$PUBLISH_PROJECT_ROOT/.venv/bin/python" ]] || {
  echo "Development environment is missing: $PUBLISH_PROJECT_ROOT/.venv" >&2
  exit 69
}
[[ $# -ge 1 ]] || {
  echo "用法：ops/publish-result <结果目录> [--csv-only|--message-only]" >&2
  exit 64
}
cd "$PUBLISH_PROJECT_ROOT"
export PYTHONDONTWRITEBYTECODE=1
exec .venv/bin/python -m roguetrader.publisher publish "$@"
