#!/usr/bin/env bash
set -euo pipefail
umask 077

SIGNAL_PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -x "$SIGNAL_PROJECT_ROOT/.venv/bin/python" ]] || {
  echo "Development environment is missing: $SIGNAL_PROJECT_ROOT/.venv" >&2
  exit 69
}

cd "$SIGNAL_PROJECT_ROOT"
export PYTHONDONTWRITEBYTECODE=1
exec .venv/bin/python -m roguetrader.backtest.signal_quality "$@"
